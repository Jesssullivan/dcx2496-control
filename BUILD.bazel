load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "LICENSE-APACHE",
    "MODULE.bazel",
    "NOTICE",
    "rust-toolchain.toml",
    "third_party/duinodcx/LICENSE",
])

alias(
    name = "dcxctl",
    actual = "//crates/dcxctl",
)

alias(
    name = "dcxctl_live_control",
    actual = "//crates/dcxctl:dcxctl_live_control",
)

alias(
    name = "dcxctl_live_discovery",
    actual = ":dcxctl_live_control",
)

alias(
    name = "apple_bundle_sources",
    actual = "//apple:bundle_sources",
)

alias(
    name = "dcx_logic_bridge_schema",
    actual = "//schemas/v1:dcx_logic_bridge_schema",
)

filegroup(
    name = "safe_profile_fixture",
    srcs = ["fixtures/profiles/safe-muted-v1.json"],
)

filegroup(
    name = "synthetic_search_fixture",
    srcs = ["fixtures/protocol/SYNTHETIC-search-response-26.hex"],
)

filegroup(
    name = "o4_mute_fixtures",
    srcs = [
        "fixtures/protocol/SYNTHETIC-o4-mute-off.hex",
        "fixtures/protocol/SYNTHETIC-o4-mute-on.hex",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":bazel_frontdoor_rejections",
        ":fixture_contract",
        ":toolchain_pin_parity",
        "//crates/dcx-core:all_tests",
        "//crates/dcx-darwin-tty:all_tests",
        "//crates/dcx-transport:all_tests",
    ],
)

# These refusal cases consult the operator's Bash/GNU realpath on PATH. They
# launch no compiler or Bazel, and have no remote/hermetic qualification claim.
sh_test(
    name = "bazel_frontdoor_rejections",
    size = "small",
    srcs = ["tests/bazel_frontdoor_rejections.sh"],
    args = ["$(location scripts/run_bazelisk.sh)"],
    data = ["scripts/run_bazelisk.sh"],
    tags = [
        "no-remote",
        "no-remote-cache",
        "no-remote-exec",
    ],
)

# The tests that declare every input they read and every tool they run, listed
# one by one rather than through the per-crate suites so adding a target to a
# crate never silently widens this set. Kept flat for the same reason.
test_suite(
    name = "remote_eligible",
    tests = [
        ":toolchain_pin_parity",
        "//crates/dcx-core:robustness",
        "//crates/dcx-core:unit_tests",
        "//crates/dcx-darwin-tty:unit_tests",
        "//crates/dcx-transport:robustness",
        "//crates/dcx-transport:unit_tests",
    ],
)

# Bazel and rustup pin the Rust toolchain in two files that nothing else ties
# together. Read both at compile time and fail if they ever disagree.
rust_test(
    name = "toolchain_pin_parity",
    size = "small",
    srcs = ["tests/toolchain_pin_parity.rs"],
    compile_data = [
        "MODULE.bazel",
        "rust-toolchain.toml",
    ],
    edition = "2024",
)

sh_test(
    name = "fixture_contract",
    size = "small",
    srcs = ["tests/fixture_contract.sh"],
    args = [
        "$(location //crates/dcxctl:dcxctl)",
        "$(location fixtures/protocol/SYNTHETIC-direct-parameter.hex)",
        "$(location fixtures/protocol/SYNTHETIC-search-response-26.hex)",
        "$(location fixtures/profiles/safe-muted-v1.json)",
        "$(location fixtures/profiles/SYNTHETIC-control-room-v1.json)",
        "$(location fixtures/rew/SYNTHETIC-cut-only.txt)",
        "$(location fixtures/protocol/SYNTHETIC-o4-mute-on.hex)",
        "$(location fixtures/protocol/SYNTHETIC-o4-mute-off.hex)",
    ],
    data = [
        "fixtures/profiles/SYNTHETIC-control-room-v1.json",
        "fixtures/profiles/safe-muted-v1.json",
        "fixtures/protocol/SYNTHETIC-direct-parameter.hex",
        "fixtures/protocol/SYNTHETIC-o4-mute-off.hex",
        "fixtures/protocol/SYNTHETIC-o4-mute-on.hex",
        "fixtures/protocol/SYNTHETIC-search-response-26.hex",
        "fixtures/rew/SYNTHETIC-cut-only.txt",
        "//crates/dcxctl",
    ],
    # The script runs bash, grep, dd, and diff out of the host PATH. Those are
    # not inputs the action declares, so this test is not describable to a
    # content-addressed executor and must never be dispatched to one.
    tags = [
        "no-remote",
        "no-remote-exec",
    ],
)
