common --enable_bzlmod
# Refuse to silently rewrite MODULE.bazel.lock. Every module extension this
# graph records is locked under the platform-independent `general` key, and the
# one extension that probes the host -- toolchains_llvm's `llvm` -- records
# nothing at all, so the lock carries no aarch64-darwin-specific entry a Linux
# runner could be made to reject. That is readable from the lock's
# `moduleExtensions` keys; the Linux lane itself remains unexercised.
common --lockfile_mode=error
common --announce_rc
build --incompatible_strict_action_env
test --test_output=errors
test --test_summary=detailed

# The cache and executor contract lives only in .bazelrc.flywheel. Never repeat
# either of the --config blocks it defines in this file: a single definition
# keeps their refusal posture from being softened by a second, looser copy.
# Concrete endpoints come from the runtime profile and auth, never from a
# committed file.
try-import %workspace%/.bazelrc.flywheel
