common --enable_bzlmod
# Refuse to silently rewrite MODULE.bazel.lock. Every module extension this
# graph records is locked under the platform-independent `general` key, and the
# one extension that probes the host -- toolchains_llvm's `llvm` -- records
# nothing at all, so the lock carries no aarch64-darwin-specific entry a Linux
# runner could be made to reject. That is readable from the lock's
# `moduleExtensions` keys; the Linux lane itself remains unexercised.
common --lockfile_mode=error
common --announce_rc
build --incompatible_strict_action_env
test --test_output=errors
test --test_summary=detailed

# dec-local-first-reapi-20261004: bounded local development is independent of
# provider enrollment. The dispatcher selects one explicit execution lane.
build:local --jobs=2
build:local --remote_executor=
build:local --remote_cache=
build:local --spawn_strategy=local
build:local --strategy_regexp=.*=local
build:local --strategy=TestRunner=local
test:local --local_test_jobs=2
test:local --test_strategy=standalone

# Endpoint, authentication and executor properties come from an external
# operator rc. Unavailable remote actions fail without local fallback.
build:reapi --jobs=2
build:reapi --spawn_strategy=remote
build:reapi --strategy_regexp=.*=remote
build:reapi --strategy=TestRunner=remote
build:reapi --remote_local_fallback=false
build:reapi --remote_download_minimal
build:reapi --host_platform=//tools/bazel/platforms:linux_x86_64
build:reapi --extra_execution_platforms=//tools/bazel/platforms:linux_x86_64

# Host-dependent shell tests use the operator toolchain, outside REAPI.
test:host-gates --test_env=PATH
