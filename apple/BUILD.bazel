load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Package.swift",
    "project.yml",
])

# Native-only test. The lab-owned PZM lane supplies the selected Xcode SDK.
sh_test(
    name = "child_failure_diagnostics",
    size = "medium",
    srcs = ["Tests/run_child_failure_diagnostics.sh"],
    args = ["$(location Package.swift)"],
    data = [
        "Package.swift",
        ":swift_package_sources",
    ],
    tags = [
        "local",
        "manual",
        "no-remote",
        "no-remote-exec",
    ],
    target_compatible_with = ["@platforms//os:osx"],
)

filegroup(
    name = "swift_package_sources",
    srcs = ["Package.swift"] + glob([
        "Sources/**/*.swift",
        "Tests/**/*.swift",
        "Tests/**/Fixtures/*.c",
    ]),
)

# dec-native-studio-20261004 / dec-local-first-reapi-20261004 / R-N13:
# Darwin fixture-only recovery proof; no serial, audio, or child process work.
sh_test(
    name = "mutation_recovery",
    size = "medium",
    srcs = ["Tests/run_mutation_recovery.sh"],
    args = [
        "$(location Package.swift)",
        "$(location Tests/DCXLogicHelperCoreTests/MutationRecoveryCoordinatorTests.swift)",
        "$(location Tests/DCXLogicHelperCoreTests/MutationRecoveryLeaseStoreTests.swift)",
    ],
    data = [
        "Package.swift",
        "Tests/DCXLogicHelperCoreTests/MutationRecoveryCoordinatorTests.swift",
        "Tests/DCXLogicHelperCoreTests/MutationRecoveryLeaseStoreTests.swift",
        ":swift_package_sources",
    ],
    tags = [
        "local",
        "manual",
        "no-remote",
        "no-remote-exec",
    ],
    target_compatible_with = ["@platforms//os:osx"],
)

# dec-native-studio-20261004 / R-N13: fixed owned child scenarios, no device.
sh_test(
    name = "process_runner",
    size = "medium",
    srcs = ["Tests/run_process_runner.sh"],
    args = [
        "$(location Package.swift)",
        "$(location Tests/DCXLogicHelperCoreTests/DCXCTLProcessRunnerTests.swift)",
        "$(location Tests/DCXLogicHelperCoreTests/Fixtures/DCXChildFixture.c)",
    ],
    data = [
        "Package.swift",
        "Tests/DCXLogicHelperCoreTests/DCXCTLProcessRunnerTests.swift",
        "Tests/DCXLogicHelperCoreTests/Fixtures/DCXChildFixture.c",
        ":swift_package_sources",
    ],
    tags = [
        "local",
        "manual",
        "no-remote",
        "no-remote-exec",
    ],
    target_compatible_with = ["@platforms//os:osx"],
)

filegroup(
    name = "bundle_sources",
    srcs = [
        "project.yml",
        ":swift_package_sources",
    ] + glob([
        "DCXControlAU/*.entitlements",
        "DCXControlAU/*.plist",
        "DCXControlAU/*.swift",
        "DCXLogicHelper/*.entitlements",
        "DCXLogicHelper/*.plist",
        "DCXLogicHelper/*.swift",
    ]),
)
