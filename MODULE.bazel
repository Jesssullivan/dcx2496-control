module(
    name = "dcx2496_control",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_llvm", version = "1.9.0")

# Pin one downloadable C/C++ toolchain so C/C++ actions stop resolving to the
# host's Apple clang wrapper. `local_config_cc` reaches xcrun and /usr/bin,
# neither of which a content-addressed executor can supply.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "22.1.8",
)
use_repo(llvm, "llvm_toolchain")

# Darwin is not yet hermetic end to end. With no explicit `llvm.sysroot`,
# toolchains_llvm resolves the macOS sysroot once, at fetch time, by running
# `/usr/bin/xcrun --show-sdk-path --sdk macosx`, and bakes that absolute path
# into the generated repository. Fetch from a shell whose DEVELOPER_DIR points
# at nixpkgs' apple-sdk and the baked SDK ships no `libc++.tbd`, so every later
# Darwin link fails until the repository is refetched. An explicit
# `llvm.sysroot(path = ...)` would only trade one host probe for one host
# literal; closing this needs a sysroot Bazel can fetch and hash. TIN-4050.
register_toolchains("@llvm_toolchain//:all")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = ["1.98.0"])
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
