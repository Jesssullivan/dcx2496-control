# Endpoint-free GloriousFlywheel cache/RBE contract. Runtime profile and auth
# supply every concrete endpoint.

build:ci-cached --remote_upload_local_results=false
build:ci-cached --remote_download_minimal
build:ci-cached --remote_timeout=60
build:ci-cached --experimental_remote_cache_ttl=3h

test:ci-cached --remote_upload_local_results=false
test:ci-cached --remote_download_minimal
test:ci-cached --remote_timeout=60
test:ci-cached --experimental_remote_cache_ttl=3h

build:executor-backed --config=ci-cached
build:executor-backed --remote_local_fallback=false
build:executor-backed --spawn_strategy=remote
build:executor-backed --remote_download_minimal
build:executor-backed --noremote_cache_compression
build:executor-backed --jobs=4
build:executor-backed --host_platform=//tools/bazel/platforms:linux_x86_64
build:executor-backed --extra_execution_platforms=//tools/bazel/platforms:linux_x86_64
test:executor-backed --noremote_cache_compression
test:executor-backed --jobs=4
