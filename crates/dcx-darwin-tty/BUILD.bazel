load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "dcx_darwin_tty",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dcx_darwin_tty",
    edition = "2024",
    deps = [
        "//crates/dcx-core:dcx_core",
        "//crates/dcx-transport:dcx_transport",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dcx_darwin_tty_test",
    edition = "2024",
    # Keep unit tests pure and platform-independent. The rust_library above
    # still compiles the native backend; Cargo's macOS suite also links and
    # exercises its injected syscall boundary without opening a tty.
    rustc_flags = ["--cfg=bazel_test_no_native"],
    deps = [
        "//crates/dcx-core:dcx_core",
        "//crates/dcx-transport:dcx_transport",
    ] + crate_deps([
        "serde",
        "serde_json",
        "sha2",
        "thiserror",
    ]),
)

# The same unit tests with the native macOS backend compiled in, as
# `just darwin-carrier-check` runs them through Cargo on a Darwin host. The
# injected syscall boundary is exercised; no tty is opened. The Darwin sysroot
# still comes from the host Xcode probe (TIN-4050), so this stays local.
rust_test(
    name = "native_unit_tests",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dcx_darwin_tty_native_test",
    edition = "2024",
    tags = [
        "local",
        "manual",
        "no-remote",
        "no-remote-exec",
    ],
    target_compatible_with = ["@platforms//os:osx"],
    deps = [
        "//crates/dcx-core:dcx_core",
        "//crates/dcx-transport:dcx_transport",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

test_suite(
    name = "all_tests",
    tests = [":unit_tests"],
)
